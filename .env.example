# Backend base URL(s), comma-separated, in order of preference.
# If the first is down (no response, or 5xx on GET), the app fails over to the next.
VITE_API_URL=https://api2.jacmov.com.br,https://apiruah.roxel.dev
# App id registered on the portal J-One / API
VITE_APP_ID=1
# Sub-path where the app is served in production (e.g. /meu-app). Leave empty to serve at root.
VITE_BASEPATH=
